{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexora",
  "version": "0.1.0",
  "identifier": "dev.hexora.desktop",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../../../frontend dev",
    "beforeBuildCommand": "pnpm -C ../../../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "Hexora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Hexora",
    "homepage": "https://github.com/Ratul-netizen/Hexora",
    "category": "DeveloperTool",
    "shortDescription": "The modern offensive security workbench.",
    "longDescription": "Hexora is a web and API security testing platform for authorized penetration testing and security research: an intercepting proxy, repeater, intruder, evidence-driven scanner, authorization testing, crawler, out-of-band collaborator, LLM and DOM-XSS testing, and a headless CI runner.",
    "copyright": "Copyright © 2026 Hexora. Licensed under AGPL-3.0-or-later.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

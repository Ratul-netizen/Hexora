{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hexora",
  "version": "0.1.0",
  "identifier": "dev.hexora.desktop",
  "build": {
    "frontendDist": "../../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../../../frontend dev",
    "beforeBuildCommand": "pnpm -C ../../../frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "Hexora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
